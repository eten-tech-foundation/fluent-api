{
  "name": "fluent-api",
  "type": "module",
  "version": "26.10.00",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/standalone-worker.ts",
    "start": "node ./dist/src/index.js",
    "worker": "node ./dist/src/workers/standalone-worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "cross-env NODE_ENV=test vitest",
    "test:live": "cross-env NODE_ENV=test vitest run --config vitest.live.config.ts",
    "test:db": "cross-env NODE_ENV=test vitest run --config vitest.db.config.ts",
    "build": "tsc && tsc-alias",
    "build:webjob": "npm run build && node scripts/setup-webjob.js",
    "deploy:prepare": "npm run build:webjob && cd wwwroot && zip -r ../deploy.zip . && cd ..",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "precheck": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "smoke:repeated-words": "tsx scripts/smoke-repeated-words.ts",
    "db:seed:rbac": "npx tsx src/db/seeds/rbac.ts",
    "db:seed:roles": "npx tsx src/db/seeds/roles.ts",
    "db:seed:org": "npx tsx src/db/seeds/organizations.ts",
    "db:seed:dev-users": "npx tsx src/db/seeds/dev-users.ts",
    "db:seed:languages": "npx tsx src/db/seeds/languages.ts",
    "db:seed:books": "npx tsx src/db/seeds/books.ts",
    "db:seed:bibles": "npx tsx src/db/seeds/bibles.ts",
    "db:seed:bible-texts": "npx tsx src/db/seeds/bible-texts.ts",
    "db:migrate-users": "npx tsx src/db/scripts/migrate-users-to-betterauth.ts",
    "db:set-password": "npx tsx src/db/scripts/set-password.ts",
    "db:create-user": "npx tsx src/db/scripts/create-user.ts",
    "db:setup": "npx tsx src/db/scripts/setup.ts",
    "db:setup:dev": "SETUP_ENV=dev npx tsx src/db/scripts/setup.ts",
    "db:setup:qa": "SETUP_ENV=qa npx tsx src/db/scripts/setup.ts",
    "db:provision:dev": "SETUP_ENV=dev npx tsx src/db/scripts/provision-db.ts",
    "db:provision:qa": "SETUP_ENV=qa npx tsx src/db/scripts/provision-db.ts",
    "db:import:languages": "npx tsx src/db/scripts/import-ethnologue-languages.ts",
    "db:import:language-names": "npx tsx src/db/scripts/enrich-language-names.ts",
    "db:migrate": "drizzle-kit migrate",
    "queue:migrate-policy": "tsx src/db/scripts/migrate-worker-queue-policy.ts",
    "db:generate": "drizzle-kit generate --name",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:sync:dbl": "npx tsx src/db/scripts/sync-dbl-catalogue.ts",
    "db:seed:pericope-sets": "npx tsx src/db/seeds/pericope-sets.ts",
    "db:backfill:milestones": "npx tsx src/db/scripts/backfill-hierarchy.ts",
    "db:consolidate:projects": "npx tsx src/db/scripts/consolidation-migration.ts",
    "lint:prune": "eslint . --prune-suppressions",
    "deadcode": "node scripts/check-dead-code.mjs",
    "verify": "npm run precheck && npm run deadcode && ./scripts/check-docs-structure.sh && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/lib-storage": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@better-auth/drizzle-adapter": "1.6.30",
    "@better-auth/passkey": "1.6.30",
    "@hono/node-server": "1.19.15",
    "@hono/zod-openapi": "0.19.10",
    "@scalar/hono-api-reference": "0.9.48",
    "@types/bcryptjs": "^2.4.6",
    "applicationinsights": "3.14.0",
    "archiver": "7.0.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.30",
    "dotenv": "16.6.1",
    "dotenv-expand": "12.0.2",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.7.1",
    "hono": "4.13.5",
    "hono-pino": "0.8.0",
    "mailgun.js": "14.1.0",
    "nanoid": "^6.0.2",
    "pg-boss": "12.1.1",
    "pino": "9.7.0",
    "postgres": "3.4.7",
    "stoker": "1.4.2",
    "usfm-grammar": "3.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@antfu/eslint-config": "4.18.0",
    "@electric-sql/pglite": "0.5.10",
    "@types/archiver": "6.0.3",
    "@types/node": "24.1.0",
    "cross-env": "7.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-format": "1.0.1",
    "husky": "9.1.7",
    "knip": "5.88.1",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsc-alias": "1.9.7",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "overrides": {
    "better-call": {
      "zod": "$zod"
    },
    "tree-sitter": "0.25.1"
  }
}
