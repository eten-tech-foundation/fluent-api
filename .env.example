NODE_ENV=development
PORT=9999
LOG_LEVEL=debug
# Role passwords below are dev-only defaults — override all three in any shared or deployed environment.
# Runtime (least-privilege) role used by the app:
DATABASE_URL=postgres://api_user:password@localhost:5432/fluent
# Migration role (DDL) used by drizzle-kit:
MIGRATIONS_DATABASE_URL=postgres://api_migrator:password@localhost:5432/fluent
# Superuser used only by the bootstrap script:
BOOTSTRAP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/fluent
BETTER_AUTH_SECRET=generate-a-32-character-secret-key
BETTER_AUTH_URL=http://localhost:9999/api/auth
BETTER_AUTH_COOKIE_DOMAIN=.fluent.bible
BETTER_AUTH_SESSION_EXPIRY_SECONDS=604800
FRONTEND_URL=http://localhost:5173
APPLICATIONINSIGHTS_CONNECTION_STRING=your-instrumentation-key

# Email (Mailgun) — all three are REQUIRED; the app fails to boot if unset.
EMAIL_SERVICE_API_KEY=your-mailgun-api-key
EMAIL_SERVICE_DOMAIN=mg.example.com
EMAIL_SERVICE_SENDER=no-reply@example.com

# Async USFM export storage. Optional: directory where export files are written.
# Defaults to $HOME/data/exports (or ./exports when HOME is unset).
# EXPORTS_DIR=/absolute/path/to/exports

# Dev seed user credentials (used by npm run db:seed:dev-users and db:setup)
SEED_MANAGER_EMAIL=pm@fluent.local
SEED_MANAGER_PASSWORD=pm@123456
SEED_TRANSLATOR_EMAIL=t@fluent.local
SEED_TRANSLATOR_PASSWORD=t@123456
SEED_TRANSLATOR2_EMAIL=t2@fluent.local
SEED_TRANSLATOR2_PASSWORD=t@123456


# Fluent-AI integration
# Base URL of the fluent-ai service (no trailing slash, no path suffix).
# - Ecosystem mode (via fluent-platform):                http://ai:8200
# - Standalone fluent-api against standalone fluent-ai:  http://localhost:8200
FLUENT_AI_URL=http://localhost:8200

# Shared API key for calling fluent-ai. Matches a row in fluent-ai's ai_api_keys table.
# Dev value seeded by fluent-ai: fai_dev_admin
FLUENT_AI_KEY=fai_dev_admin

# Path prefix fluent-ai mounts its routers under, inserted between FLUENT_AI_URL
# and the per-tool path. The current live fluent-ai build serves at the root
# (e.g. POST /tools/greek-room/repeated-words), so leave this empty. If/when
# fluent-ai adopts versioned routing, set this to /api/v1 — no code change needed.
FLUENT_AI_API_PREFIX=

# Key used to authenticate incoming webhook callbacks from fluent-ai
AI_INBOUND_SERVICE_KEY=generate-a-32-character-secret-key

# AI suggestion tunables (all optional — shown here at their code defaults).
# Min translated verses in a project before AI suggestions activate.
AI_ACTIVATION_THRESHOLD_VERSES=500
# How many verses ahead of the active verse to pre-generate on navigation.
AI_DEFAULT_LOOKAHEAD=3
# How many upcoming verses to queue when a chapter is first assigned.
AI_INITIAL_QUEUE_COUNT=3
# Max bibleTextIds accepted in a single GET /ai-suggestions request.
AI_MAX_REQUESTED_BIBLE_TEXT_IDS=200
# HTTP timeout (ms) for the fire-and-forget trigger call to fluent-ai. Protects
# the pgboss worker from hanging if fluent-ai freezes.
AI_TRIGGER_TIMEOUT_MS=10000

# Feature flags (EN_FEATURE_*)
# One flat boolean per optional feature, published (camelCased) by
# GET /config/features so the front-end can hide AI-dependent UI where the
# backend isn't wired. Accepted: true/false, 1/0, yes/no, on/off.
#
# EN_FEATURE_REPEATED_WORD_CHECK — the Repeated Word Check UI. Leave UNSET to
# derive the safe default: on only when FLUENT_AI_URL + FLUENT_AI_KEY are both
# set, off otherwise. Set explicitly to force it either way.
# (A flag is declared in three synced places: src/env.ts, the FLAGS registry in
# src/lib/features.ts, and the OpenAPI schema in src/routes/config.route.ts.)
EN_FEATURE_REPEATED_WORD_CHECK=

# EN_FEATURE_AI_SUGGESTIONS — the AI Suggestions UI. Same contract as
# EN_FEATURE_REPEATED_WORD_CHECK above: leave UNSET to derive the safe default
# from AI wiring, or set explicitly to force it either way.
EN_FEATURE_AI_SUGGESTIONS=

# ── Verse audio storage (Cloudflare R2) ──────────────────────────────────
# Leave the credentials unset to disable the verse-audio endpoints (they return
# 503 and nothing else is affected).
#
# ⚠️ GDPR: the bucket must be CREATED in the EU jurisdiction — that is set at
# bucket-creation time in the Cloudflare dashboard/IaC and cannot be done from
# code. R2_JURISDICTION below only pins the endpoint the API talks to; it does
# not move an existing bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Endpoint jurisdiction segment: 'eu' → {account}.eu.r2.cloudflarestorage.com
# (data at rest stays in the EU). 'default' uses the un-pinned global endpoint.
R2_JURISDICTION=eu
# Bucket for recordings. Deliberately NOT the exports bucket: exports are swept
# on a TTL, recordings are permanent.
R2_AUDIO_BUCKET=verse-audio
# How often orphaned objects are reclaimed. Dropping a project unit cascades its
# recording rows away; Postgres cannot delete the objects, so storage_objects
# rows survive as markers and this sweep frees the bytes.
AUDIO_RECLAIM_INTERVAL_MS=3600000
# Overrides the endpoint entirely — the only way to point local dev at MinIO or
# another S3-compatible server. Leave UNSET against real R2, otherwise the
# jurisdiction pinned above is bypassed.
# R2_ENDPOINT=http://localhost:9000
R2_ENDPOINT=
# How long a freshly claimed storage row is left alone before the sweep may
# reclaim it (an upload claims its row just before writing, so it briefly looks
# orphaned).
AUDIO_RECLAIM_GRACE_MS=3600000
#
# Local dev: R2 has no official emulator — run MinIO and set R2_ENDPOINT above,
# or use a real R2 dev bucket.
